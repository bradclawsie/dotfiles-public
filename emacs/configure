#!/usr/bin/env fish
set gcc_version (gcc -dumpversion | string split -f1 .);
sudo apt install -y libgccjit-$gcc_version-dev;
sudo apt install -y build-essential libgnutls28-dev zlib1g-dev libtree-sitter-dev pkgconf libncurses-dev;
./configure \
    --prefix="$HOME/local/emacs" \
    --without-x \
    --without-pgtk \
    --without-ns \
    --with-native-compilation \
    --with-tree-sitter \
    --with-gnutls=ifavailable;

